# Service / after-sales module: technician, service_job, service_visit_log, exchange_request, refund, returned_item, complaint
@url = {{$dotenv SUPABASE_URL}}
@key = {{$dotenv SUPABASE_ANON_KEY}}
@token = {{login.response.body.$.access_token}}

### 0) Sign in first (click "Send Request" here) – the other requests use this token
# @name login
POST {{url}}/auth/v1/token?grant_type=password
apikey: {{key}}
Content-Type: application/json

{ "email": "{{$dotenv TEST_EMAIL}}", "password": "{{$dotenv TEST_PASSWORD}}" }

### 1) Technicians with their staff profile
GET {{url}}/rest/v1/technician?select=technician_id,is_available,user(full_name,email),technician_specialisation(specialisation)
apikey: {{key}}
Authorization: Bearer {{token}}

### 1b) Skills of each technician (multivalued attribute: one row per skill)
GET {{url}}/rest/v1/technician_specialisation?select=specialisation,technician(technician_id,user(full_name))&order=technician_id
apikey: {{key}}
Authorization: Bearer {{token}}

### 2) Open service jobs (not completed or cancelled)
GET {{url}}/rest/v1/service_job?select=service_job_id,job_type,status,priority,scheduled_date,fault_description,customer(name),technician(technician_id)&status=not.in.(completed,cancelled)&order=service_job_id
apikey: {{key}}
Authorization: Bearer {{token}}

### 3) Jobs of technician 1 (Ruwan)
GET {{url}}/rest/v1/service_job?select=service_job_id,job_type,status,priority,created_date&technician_id=eq.1&order=service_job_id.desc
apikey: {{key}}
Authorization: Bearer {{token}}

### 4) One job with its visit log (JOB-035 = service_job_id 35)
GET {{url}}/rest/v1/service_job?select=*,service_visit_log(*)&service_job_id=eq.35
apikey: {{key}}
Authorization: Bearer {{token}}

### 5) CREATE a test service job
POST {{url}}/rest/v1/service_job
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json
Prefer: return=representation

{ "job_type": "maintenance", "status": "pending", "priority": "normal", "fault_description": "API-TEST-JOB please delete", "customer_id": 1, "service_fee": 2500, "billing_status": "unbilled", "created_date": "2026-11-01" }

### 6) UPDATE the test job status
PATCH {{url}}/rest/v1/service_job?fault_description=like.API-TEST-JOB*
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json
Prefer: return=representation

{ "status": "cancelled" }

### 7) DELETE the test job
DELETE {{url}}/rest/v1/service_job?fault_description=like.API-TEST-JOB*
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json
Prefer: return=representation

### 8) Return / exchange requests with refund
GET {{url}}/rest/v1/exchange_request?select=exchange_request_id,request_type,reason,status,request_date,customer(name),product(name),refund(refund_amount,status,refund_date)
apikey: {{key}}
Authorization: Bearer {{token}}

### 9) Returned items inspected by the store
GET {{url}}/rest/v1/returned_item?select=*
apikey: {{key}}
Authorization: Bearer {{token}}

### 10) Complaints with customer
GET {{url}}/rest/v1/complaint?select=complaint_id,complaint_date,subject,status,priority,resolution,service_job_id,customer(name)
apikey: {{key}}
Authorization: Bearer {{token}}
