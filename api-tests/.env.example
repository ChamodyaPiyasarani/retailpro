# Copy this file to  api-tests/.env  and fill in the values (the .env file is NOT uploaded to GitHub).
# SUPABASE_URL and SUPABASE_ANON_KEY are the same values as VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY in the app's .env
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# a staff account used to sign in for the tests
TEST_EMAIL=admin@gmail.com
TEST_PASSWORD=
