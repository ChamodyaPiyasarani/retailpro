# Finance module: payment, transaction, payable, invoice
@url = {{$dotenv SUPABASE_URL}}
@key = {{$dotenv SUPABASE_ANON_KEY}}
@token = {{login.response.body.$.access_token}}

### 0) Sign in first (click "Send Request" here) – the other requests use this token
# @name login
POST {{url}}/auth/v1/token?grant_type=password
apikey: {{key}}
Content-Type: application/json

{ "email": "{{$dotenv TEST_EMAIL}}", "password": "{{$dotenv TEST_PASSWORD}}" }

### 1) Customer payments (latest first)
GET {{url}}/rest/v1/payment?select=payment_id,reference_number,payment_date,amount,payment_method,invoice_id&payment_type=eq.customer&order=payment_date.desc&limit=20
apikey: {{key}}
Authorization: Bearer {{token}}

### 2) Supplier payments
GET {{url}}/rest/v1/payment?select=payment_id,reference_number,payment_date,amount,payment_method,payable_id&payment_type=eq.supplier&order=payment_date.desc
apikey: {{key}}
Authorization: Bearer {{token}}

### 3) Refund payments
GET {{url}}/rest/v1/payment?select=*&is_refund=eq.true
apikey: {{key}}
Authorization: Bearer {{token}}

### 4) All money in / out (transaction table), latest first
GET {{url}}/rest/v1/transaction?select=transaction_id,transaction_type,amount,transaction_date,related_reference&order=transaction_date.desc&limit=30
apikey: {{key}}
Authorization: Bearer {{token}}

### 5) Transactions for a date range (change the dates)
GET {{url}}/rest/v1/transaction?select=*&transaction_date=gte.2026-10-01&transaction_date=lte.2026-10-31&order=transaction_date
apikey: {{key}}
Authorization: Bearer {{token}}

### 6) Pending payables
GET {{url}}/rest/v1/payable?select=*&status=eq.pending
apikey: {{key}}
Authorization: Bearer {{token}}

### 7) Service job invoices
GET {{url}}/rest/v1/invoice?select=invoice_id,notes,invoice_date,amount_due,status,service_job_id&service_job_id=not.is.null
apikey: {{key}}
Authorization: Bearer {{token}}
