# Finance and reports: payment, invoice, report
# Use cases: Process customer payment, Record supplier payment, View all payments,
# Generate business / stock / financial report, View dashboard
@url = {{$dotenv SUPABASE_URL}}
@key = {{$dotenv SUPABASE_ANON_KEY}}
@token = {{login.response.body.$.access_token}}

### 0) Sign in first (click "Send Request" here) – the other requests use this token
# @name login
POST {{url}}/auth/v1/token?grant_type=password
apikey: {{key}}
Content-Type: application/json

{ "email": "{{$dotenv TEST_EMAIL}}", "password": "{{$dotenv TEST_PASSWORD}}" }

### 1) All payments, newest first
GET {{url}}/rest/v1/payment?order=payment_date.desc
apikey: {{key}}
Authorization: Bearer {{token}}

### 2) Customer payments with their invoice
GET {{url}}/rest/v1/payment?select=*,invoice(invoice_id,amount,status)&payment_type=eq.Customer&order=payment_id.desc
apikey: {{key}}
Authorization: Bearer {{token}}

### 3) Supplier payments (cheques) with the purchase order
GET {{url}}/rest/v1/payment?select=*,purchase_order(po_id,total_amount,status)&payment_type=eq.Supplier
apikey: {{key}}
Authorization: Bearer {{token}}

### 4) Received purchase orders not paid yet
GET {{url}}/rest/v1/purchase_order?status=eq.Received
apikey: {{key}}
Authorization: Bearer {{token}}

### 5) Report history – saved reports with the user who made them
GET {{url}}/rest/v1/report?select=*,user(name)&order=report_id
apikey: {{key}}
Authorization: Bearer {{token}}

### 6) Sales of the last days (for the dashboard chart)
GET {{url}}/rest/v1/sales_order?select=order_date,total_amount&status=eq.Completed&order=order_date.desc&limit=20
apikey: {{key}}
Authorization: Bearer {{token}}
