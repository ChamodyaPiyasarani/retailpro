# Service: service_job, repair_note, spare_part_request, technician
# Use cases: Register service request, Assign technician to service job, View assigned jobs, Update job status, View service history
@url = {{$dotenv SUPABASE_URL}}
@key = {{$dotenv SUPABASE_ANON_KEY}}
@token = {{login.response.body.$.access_token}}

### 0) Sign in first (click "Send Request" here) – the other requests use this token
# @name login
POST {{url}}/auth/v1/token?grant_type=password
apikey: {{key}}
Content-Type: application/json

{ "email": "{{$dotenv TEST_EMAIL}}", "password": "{{$dotenv TEST_PASSWORD}}" }

### 1) Service jobs with customer, product and technician
GET {{url}}/rest/v1/service_job?select=*,customer(name),product(product_name),technician(user(name))&order=job_id
apikey: {{key}}
Authorization: Bearer {{token}}

### 2) Jobs assigned to technician 1 that are not completed
GET {{url}}/rest/v1/service_job?technician_id=eq.1&status=neq.Completed
apikey: {{key}}
Authorization: Bearer {{token}}

### 3) Available technicians
GET {{url}}/rest/v1/technician?select=*,user(name)&is_available=eq.true
apikey: {{key}}
Authorization: Bearer {{token}}

### 4) Service history of product 1 with repair notes
GET {{url}}/rest/v1/service_job?select=*,repair_note(note_date,details)&product_id=eq.1&order=request_date.desc
apikey: {{key}}
Authorization: Bearer {{token}}

### 5) Service invoices (invoice with a job_id)
GET {{url}}/rest/v1/invoice?job_id=not.is.null
apikey: {{key}}
Authorization: Bearer {{token}}

### 6) CREATE a test service job
POST {{url}}/rest/v1/service_job
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json
Prefer: return=representation

{ "job_type": "Repair", "fault": "API test fault", "status": "Pending", "request_date": "2026-11-06", "service_charge": 0, "customer_id": 1, "product_id": 1 }

### 7) READ the test service job
GET {{url}}/rest/v1/service_job?fault=eq.API test fault
apikey: {{key}}
Authorization: Bearer {{token}}

### 8) UPDATE the test job status
PATCH {{url}}/rest/v1/service_job?fault=eq.API test fault
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json
Prefer: return=representation

{ "status": "In Progress" }

### 9) DELETE the test service job
DELETE {{url}}/rest/v1/service_job?fault=eq.API test fault
apikey: {{key}}
Authorization: Bearer {{token}}
