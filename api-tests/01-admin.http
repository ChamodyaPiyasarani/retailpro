# Administration: user, role, permission, role_permission, technician, technician_specialisation, discount
# Use cases: Manage user accounts, Manage roles and permissions, Manage discounts
@url = {{$dotenv SUPABASE_URL}}
@key = {{$dotenv SUPABASE_ANON_KEY}}
@token = {{login.response.body.$.access_token}}

### 0) Sign in first (click "Send Request" here) – the other requests use this token
# @name login
POST {{url}}/auth/v1/token?grant_type=password
apikey: {{key}}
Content-Type: application/json

{ "email": "{{$dotenv TEST_EMAIL}}", "password": "{{$dotenv TEST_PASSWORD}}" }

### 1) All roles
GET {{url}}/rest/v1/role?order=role_id
apikey: {{key}}
Authorization: Bearer {{token}}

### 2) All 35 permissions (one for each use case)
GET {{url}}/rest/v1/permission?order=module,permission_id
apikey: {{key}}
Authorization: Bearer {{token}}

### 3) Each role with its permissions
GET {{url}}/rest/v1/role?select=role_name,role_permission(permission(permission_name))&order=role_id
apikey: {{key}}
Authorization: Bearer {{token}}

### 4) All users with their role
GET {{url}}/rest/v1/user?select=user_id,name,email,phone,is_active,last_login,role(role_name)&order=user_id
apikey: {{key}}
Authorization: Bearer {{token}}

### 5) Technicians with their user name and specialisations
GET {{url}}/rest/v1/technician?select=technician_id,is_available,experience_years,user(name),technician_specialisation(specialisation)
apikey: {{key}}
Authorization: Bearer {{token}}

### 6) CREATE a test role
POST {{url}}/rest/v1/role
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json
Prefer: return=representation

{ "role_name": "API Test Role", "description": "Created from REST Client", "is_active": true }

### 7) Give the test role a permission (Check warranty status = 15) – change role_id to the id from step 6
POST {{url}}/rest/v1/role_permission
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json
Prefer: return=representation

{ "role_id": 7, "permission_id": 15, "granted_date": "2026-11-06" }

### 8) READ the test role and its permissions
GET {{url}}/rest/v1/role?select=*,role_permission(permission(permission_name))&role_name=eq.API Test Role
apikey: {{key}}
Authorization: Bearer {{token}}

### 9) UPDATE the test role
PATCH {{url}}/rest/v1/role?role_name=eq.API Test Role
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json
Prefer: return=representation

{ "description": "Updated from REST Client" }

### 10) DELETE the test role (its role_permission rows are deleted with it)
DELETE {{url}}/rest/v1/role?role_name=eq.API Test Role
apikey: {{key}}
Authorization: Bearer {{token}}

### 11) All discounts
GET {{url}}/rest/v1/discount?order=discount_id
apikey: {{key}}
Authorization: Bearer {{token}}

### 12) CREATE a test discount
POST {{url}}/rest/v1/discount
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json
Prefer: return=representation

{ "discount_code": "APITEST5", "rate": 5, "description": "REST Client test", "start_date": "2026-01-01", "end_date": "2026-12-31", "is_active": true }

### 13) UPDATE the test discount
PATCH {{url}}/rest/v1/discount?discount_code=eq.APITEST5
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json
Prefer: return=representation

{ "rate": 7.5 }

### 14) DELETE the test discount
DELETE {{url}}/rest/v1/discount?discount_code=eq.APITEST5
apikey: {{key}}
Authorization: Bearer {{token}}
