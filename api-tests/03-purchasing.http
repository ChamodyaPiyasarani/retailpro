# Purchase module: supplier, quotation, purchase_order, purchase_order_item, payable
@url = {{$dotenv SUPABASE_URL}}
@key = {{$dotenv SUPABASE_ANON_KEY}}
@token = {{login.response.body.$.access_token}}

### 0) Sign in first (click "Send Request" here) – the other requests use this token
# @name login
POST {{url}}/auth/v1/token?grant_type=password
apikey: {{key}}
Content-Type: application/json

{ "email": "{{$dotenv TEST_EMAIL}}", "password": "{{$dotenv TEST_PASSWORD}}" }

### 1) All suppliers
GET {{url}}/rest/v1/supplier?select=*&order=supplier_id
apikey: {{key}}
Authorization: Bearer {{token}}

### 2) Active suppliers only
GET {{url}}/rest/v1/supplier?select=supplier_id,name,contact_person,phone,rating,status&status=eq.active
apikey: {{key}}
Authorization: Bearer {{token}}

### 3) CREATE a test supplier
POST {{url}}/rest/v1/supplier
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json
Prefer: return=representation

{ "name": "API Test Supplier", "contact_person": "Test Person", "phone": "0110000001", "email": "api.supplier@example.com", "payment_terms": 30, "rating": 4, "status": "active" }

### 4) UPDATE the test supplier rating
PATCH {{url}}/rest/v1/supplier?email=eq.api.supplier@example.com
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json
Prefer: return=representation

{ "rating": 4.5 }

### 5) DELETE the test supplier
DELETE {{url}}/rest/v1/supplier?email=eq.api.supplier@example.com
apikey: {{key}}
Authorization: Bearer {{token}}
Content-Type: application/json
Prefer: return=representation

### 6) Quotations with supplier
GET {{url}}/rest/v1/quotation?select=*,supplier(name)&order=quotation_id
apikey: {{key}}
Authorization: Bearer {{token}}

### 7) Purchase orders with supplier and lines
GET {{url}}/rest/v1/purchase_order?select=po_id,order_date,expected_delivery_date,received_date,total_amount,status,is_urgent,supplier(name),purchase_order_item(quantity,unit_cost,received_qty,product(name))&order=po_id.desc
apikey: {{key}}
Authorization: Bearer {{token}}

### 8) Purchase orders not received yet
GET {{url}}/rest/v1/purchase_order?select=po_id,order_date,expected_delivery_date,status,supplier(name)&status=in.(draft,approved,ordered,partial,escalated,flagged)
apikey: {{key}}
Authorization: Bearer {{token}}

### 9) Money owed to suppliers (payables still pending)
GET {{url}}/rest/v1/payable?select=payable_id,amount_due,due_date,status,supplier(name),po_id&status=eq.pending
apikey: {{key}}
Authorization: Bearer {{token}}
